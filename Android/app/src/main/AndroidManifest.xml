<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- SSH to the Mac (its local addresses, the tailnet), the pairing listener. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Network changes: reconnect, check a connection that may have died. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- NSD (Bonjour): the pairing listener `_aos-pair._tcp` and the Mac's `_ssh._tcp`. -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <!-- The terminal: a foreground service keeps the connection while a terminal on the Mac is open
         (terminal/TerminalKeepAliveService.kt), with its notification. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- The UI: the pairing code's QR scanner (on the phone, nothing leaves it), the screen lock before approvals and
         for "Unlock to open aOS", notifications for requests while the app is in the background. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />
    <!-- Tablets, foldables, Chromebooks and desktop windows: a mouse or trackpad and a keyboard do everything, so a
         touchscreen isn't needed (the link can be typed or opened instead of scanned). -->
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.hardware.faketouch" android:required="false" />

    <!-- Tailscale's sign-in page opens in a Custom Tab. -->
    <queries>
        <intent>
            <action android:name="android.support.customtabs.action.CustomTabsService" />
        </intent>
    </queries>

    <application
        android:name=".AosApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:localeConfig="@xml/locales_config"
        android:supportsRtl="true"
        android:resizeableActivity="true"
        android:theme="@style/Theme.AOS">
        <!-- Several windows side by side stay live at once (Chromebooks before Android 10 asked for this). -->
        <meta-data android:name="android.allow_multiple_resumed_activities" android:value="true" />
        <!-- One app for phones, tablets, foldables and desktop windows: resizable (split screen, freeform), every
             orientation, no fixed aspect ratio. Changes of the window's size or shape, of the keyboard and of light
             and dark don't restart the activity (configChanges): Compose lays out again, and the terminal's view and
             a running screen session stay (MainActivity.onConfigurationChanged). Language, font scale and density
             still restart it; the UI's state is kept across that (MainActivity.UiHolder). -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:resizeableActivity="true"
            android:screenOrientation="unspecified"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|navigation|touchscreen|uiMode"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- The pairing link from the Mac's QR code (aos-pair://v1?...). -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="aos-pair" />
            </intent-filter>
        </activity>
        <!-- Keeps the SSH connection to the Mac while a terminal is open and the app is in the background. -->
        <service
            android:name=".terminal.TerminalKeepAliveService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Keeps the person's open SSH terminal session to their own Mac connected while the app is in the background; the notification shows it and ends it." />
        </service>
    </application>
</manifest>
