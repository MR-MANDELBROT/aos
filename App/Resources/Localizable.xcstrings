    "So the Mac stays awake with the lid closed: Login Items & Extensions, \"Allow in the Background\"." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Damit der Mac mit geschlossenem Deckel wach bleibt: „Anmeldeobjekte & Erweiterungen“, „Im Hintergrund erlauben“."
          }
        }
      }
    },
    "Start %@ at login" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ beim Anmelden starten"
          }
        }
      }
    },
    "Start chats on this Mac from the Claude app and keep conversations reachable when you leave the Mac." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Starte Chats auf diesem Mac aus der Claude-App und halte Unterhaltungen erreichbar, wenn du vom Mac weggehst."
          }
