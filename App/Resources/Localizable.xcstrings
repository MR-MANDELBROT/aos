    },
    "Claude Code asks once whether you trust this folder: chats started from the Claude app can read and change files there and run programs, and the folder's Claude Code settings apply to them." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claude Code fragt einmal, ob du diesem Ordner vertraust: Chats aus der Claude-App können dort Dateien lesen und ändern und Programme ausführen, und die Claude-Code-Einstellungen des Ordners gelten für sie."
          }
        }
      }
    },
    "Claude Code asks something" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
