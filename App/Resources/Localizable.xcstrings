    " · with one-time code" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " · mit Einmalcode"
          }
        }
      }
    },
    "·" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "·"
          }
        }
      }
    },
    "\"%@\" reachable in the Claude app" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%@“ in der Claude-App erreichbar"
          }
        }
      }
    },
    "[*.]google.com" : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "[*.]google.com"
          }
        }
      }
    },
    "%@ · the current code" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ · der aktuelle Code"
          }
        }
      }
    },
    "%@ adds its tools to your agents. Opening the workspace always needs your approval: in the agent if it asks for tool permissions, otherwise here on your Mac." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ trägt seine Werkzeuge in deine Agents ein. Das Öffnen des Arbeitsplatzes braucht immer dein Ja: im Agent, wenn er nach Werkzeug-Erlaubnissen fragt, sonst hier auf dem Mac."
          }
        }
      }
    },
    "%@ asks Bitwarden for exactly the login you approve; your passwords stay in Bitwarden." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ fragt Bitwarden nur nach der Anmeldung, die du freigibst; deine Passwörter bleiben in Bitwarden."
          }
        }
      }
    },
    "%@ asks for a one-time code" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ bittet um einen Einmalcode"
          }
        }
      }
    },
    "%@ changes this in macOS's Wi-Fi settings for you." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ stellt das für dich in den WLAN-Einstellungen von macOS um."
          }
        }
      }
    },
    "%@ connected" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ verbunden"
          }
        }
      }
    },
    "%@ creates the virtual Mac and installs macOS into it. This takes about 10 minutes; you can keep working meanwhile." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ legt den virtuellen Mac an und installiert macOS darin. Das dauert etwa 10 Minuten; du kannst so lange weiterarbeiten."
          }
        }
      }
    },
    "%@ gives your coding agent its own Mac: a virtual Mac with its own screen and browser, separate from yours. Your agent uses it for tasks that need a website or an app; you approve every time it opens." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ gibt deinem Coding-Agent einen eigenen Mac: einen virtuellen Mac mit eigenem Bildschirm und Browser, getrennt von deinem. Dein Agent nutzt ihn für Aufgaben, die eine Website oder eine App brauchen; jedes Öffnen bestätigst du."
          }
        }
      }
    },
    "%@ is paired: approve sign-ins with Face ID, also on the go." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ist gekoppelt: Anmeldungen mit Face ID freigeben, auch unterwegs."
          }
        }
      }
    },
    "%@ is paired." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ist gekoppelt."
          }
        }
      }
    },
    "%@ isn't on your iPhone yet?" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ist noch nicht auf deinem iPhone?"
          }
        }
      }
    },
    "%@ keeps the workspace's keys and its disk in a background helper of its own. So no other program on your Mac, not even your agent, can take the workspace over or watch a sign-in. macOS asks you once to allow it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ verwahrt die Schlüssel und die Festplatte des Arbeitsplatzes in einem eigenen Hintergrunddienst. So kann kein anderes Programm auf deinem Mac, auch nicht dein Agent, den Arbeitsplatz übernehmen oder bei einer Anmeldung zusehen. macOS fragt dich einmal, ob du ihn erlaubst."
          }
        }
      }
    },
    "%@ on your iPhone" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ auf deinem iPhone"
          }
        }
      }
    },
    "%@ paired, not connected now" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ gekoppelt, gerade nicht verbunden"
          }
        }
      }
    },
    "%@ runs Bitwarden's official command line tool as a program of its own and checks Bitwarden's signature before using it. It isn't part of %@." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ startet das offizielle Befehlszeilenprogramm von Bitwarden als eigenes Programm und prüft vor der Verwendung die Signatur von Bitwarden. Es ist kein Teil von %2$@."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ runs Bitwarden's official command line tool as a program of its own and checks Bitwarden's signature before using it. It isn't part of %2$@."
          }
        }
      }
    },
    "%@ starts with your Mac and shows what the workspace is doing." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ startet mit deinem Mac und zeigt, was der Arbeitsplatz gerade macht."
          }
        }
      }
    },
    "%@ types this into the workspace and submits it. Your agent never sees it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ trägt das im Arbeitsplatz ein und schickt es ab. Dein Agent sieht es nie."
          }
        }
      }
    },
    "%@ wants to open its workspace" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ möchte seinen Arbeitsplatz öffnen"
          }
        }
      }
    },
    "%@ wants to open the workspace" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ möchte den Arbeitsplatz öffnen"
          }
        }
      }
    },
    "%@ wants to sign in" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ möchte sich anmelden"
          }
        }
      }
    },
    "%@'s background helper is being updated. Try again in a minute or two." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Hintergrunddienst von %@ wird gerade aktualisiert. Versuch es in ein, zwei Minuten noch einmal."
          }
        }
      }
    },
    "%@'s background helper keeps the workspace's keys and disk. Allow it in %@'s settings (General)." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Hintergrunddienst von %1$@ verwahrt die Schlüssel und die Festplatte des Arbeitsplatzes. Erlaube ihn in den Einstellungen von %2$@ (Allgemein)."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@'s background helper keeps the workspace's keys and disk. Allow it in %2$@'s settings (General)."
          }
        }
