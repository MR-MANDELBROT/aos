            "value" : "Aktualisieren"
          }
        }
      }
    },
    "Use Recommended" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Empfohlene übernehmen"
          }
        }
      }
    },
    "User name or email" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Benutzername oder E-Mail"
          }
        }
