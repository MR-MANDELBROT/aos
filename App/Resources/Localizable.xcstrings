            "value" : "Erlaubt"
          }
        }
      }
    },
    "Also conversations from a terminal. Not recommended: when you close a terminal on purpose, the conversation keeps running anyway." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auch Unterhaltungen aus einem Terminal. Nicht empfohlen: Schließt du ein Terminal mit Absicht, läuft die Unterhaltung trotzdem weiter."
          }
        }
      }
    },
    "Also conversations started in a terminal" : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auch Unterhaltungen aus dem Terminal"
          }
        }
      }
    },
    "Also reachable from your phone" : {
      "localizations" : {
