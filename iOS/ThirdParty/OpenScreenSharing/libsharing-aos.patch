+// aOS: what LoginCheck.Security says.
+func securityText(info rfb.ServerInfo) string {
+	offered := make([]string, 0, len(info.SecurityTypes))
+	for _, securityType := range info.SecurityTypes {
+		offered = append(offered, securityType.String())
+	}
+	return "offered " + strings.Join(offered, " ") + ", used " + info.SecurityType.String()
 }
