    "the Mac showed no screen sharing key through SSH (%@)" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "der Mac hat über SSH keinen Schlüssel der Bildschirmfreigabe gezeigt (%@)"
          }
        }
      }
    },
    "The Mac sleeps as usual." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Mac schläft wie gewohnt."
          }
        }
