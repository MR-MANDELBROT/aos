    "How the iPhone reaches it" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "So erreicht ihn das iPhone"
          }
        }
      }
    },
    "If you install the Tailscale app later and sign in with the same account, aOS's devices appear in the same tailnet, and you manage them there like any other device. The Tailscale app can't take over aOS's connection." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Installierst du später die Tailscale-App und meldest dich mit demselben Konto an, erscheinen die Geräte von aOS im selben Tailnet, und du verwaltest sie dort wie jedes andere Gerät. Die Verbindung von aOS übernehmen kann die Tailscale-App nicht."
          }
        }
      }
    },
    "Import" : {
      "extractionState" : "manual",
      "localizations" : {
