    "With a monitor" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mit einem Monitor"
          }
        }
      }
    },
    "Without Bitwarden, your password app's AutoFill fills the fields in the request; aOS sends them once, encrypted over SSH, and doesn't keep them." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ohne Bitwarden füllt das automatische Ausfüllen deiner Passwort-App die Felder der Anfrage; aOS sendet sie einmal, verschlüsselt über SSH, und behält sie nicht."
          }
        }
      }
    },
    "worked last" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "zuletzt erreicht"
          }
        }
      }
