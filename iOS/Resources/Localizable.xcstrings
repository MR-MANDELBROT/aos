        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "aOS entsperren"
          }
        }
      }
    },
    "Unlock it in aOS on the Mac. The logins for this website then appear here." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entsperre es in aOS auf dem Mac. Die Anmeldungen für diese Website erscheinen dann hier."
